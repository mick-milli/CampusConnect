# Copy this file to server/.env and fill in your keys to enable real payments.
# Without PAYSTACK_SECRET_KEY the escrow flow falls back to a simulated charge,
# so local development keeps working out of the box.

# ---- Supabase (database) ----
# Set BOTH of these to store data in Supabase Postgres. Leave them blank to use
# the local data.json file instead. Find them in your Supabase project under
# Project Settings → API. Use the *service_role* key (server-side only — never
# expose it in the browser). First run: create the tables with server/supabase.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Email confirmation (signup) ----
# Signup emails a confirmation link ONLY when your Supabase project has it on:
#   Dashboard → Authentication → Providers → Email → "Confirm email" = ON.
# You also need working email delivery — the built-in sender is rate-limited to
# a few messages/hour (fine for testing); configure custom SMTP under
# Authentication → Emails for production.
# Add "<your-site>/auth/confirm" to Authentication → URL Configuration →
# Redirect URLs so the link is allowed to send users back to the app.
# With "Confirm email" OFF, signup logs the user straight in (no email) — the
# app supports both, so local dev works without SMTP.
#
# Base URL of the frontend, used to build the confirmation redirect. Defaults to
# the browser's own origin, so you usually only need this for a fixed prod URL.
# CLIENT_URL=https://your-domain

# Paystack secret key (Dashboard → Settings → API Keys & Webhooks).
# Use the TEST key while developing: sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=

# Optional overrides
# PORT=4000
# JWT_SECRET=change-me-in-production

# ---- Paystack webhook ----
# Point your Dashboard webhook URL at:  https://<your-domain>/api/paystack/webhook
# (For local testing, expose it with a tunnel, e.g. `ngrok http 4000`.)
# The webhook is optional for the redirect flow — payments are also verified
# when Paystack redirects the customer back to /orders.
